; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="S^erap^S"
config/description="Визуальная новелла S^erap^S — порт веб-версии на Godot 4"
config/version="0.19.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.027, 0.024, 0.039, 1)
config/icon="res://icon.svg"
config/quit_on_go_back=false

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Game="*res://scripts/autoload/game.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Mobile="*res://scripts/autoload/mobile.gd"
Audio="*res://scenes/audio/audio.tscn"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://ui/theme.tres"

[importer_defaults]

texture={
"compress/lossy_quality": 0.85,
"compress/mode": 1,
"mipmaps/generate": true
}

